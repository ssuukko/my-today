# Copy to .env.supabase. Keep real credentials out of Git and browser variables.
# Use the Supabase Connect dialog's Session pooler endpoint on port 5432.
# Example JDBC URL (replace the host, keep the password in its separate field):
# jdbc:postgresql://SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/certs/supabase-ca.crt
EXTERNAL_DB_URL=
# Dedicated application role's session pooler username: mytoday_app.PROJECT_REF
EXTERNAL_DB_USERNAME=
EXTERNAL_DB_PASSWORD=
